<?xml version="1.1" encoding="UTF-8"?>
<gpx version="1.1" creator="grass-cli" xmlns="[http://www.topografix.com/GPX/1/1](http://www.topografix.com/GPX/1/1)">
  <metadata>
    <name>Forest Loop by the Creek</name>
    <desc>A serene 5km loop through a forest with a gentle water feature.</desc>
  </metadata>
  <trk>
    <name>Forest Loop by the Creek</name>
    <trkseg>
      <trkpt lat="39.9042" lon="-75.1633">
        <name>Start Point</name>
        <desc>Begin your hike at the trailhead near the parking lot.</desc>
      </trkpt>
      <trkpt lat="39.9045" lon="-75.163">
        <name>Creek Crossing</name>
        <desc>Cross the small creek and enjoy the sound of flowing water.</desc>
      </trkpt>
      <trkpt lat="39.9048" lon="-75.1627">
        <name>Scenic Viewpoint</name>
        <desc>Pause here to admire the forest canopy and the view of the creek.</desc>
      </trkpt>
      <trkpt lat="39.9042" lon="-75.1633">
        <name>End Point</name>
        <desc>Return to the starting point, completing the loop.</desc>
      </trkpt>
    </trkseg>
  </trk>
</gpx>